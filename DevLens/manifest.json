{
  "manifest_version": 3,
  "name": "DevLens — Developer & Designer HUD, Code Utilities & Micro-Break",
  "version": "1.0.0",
  "description": "Universal developer and designer inspector, live CSS color token sampler, code converter utilities, Git cheat sheets, and micro-break code quiz game.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "documentPictureInPicture"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DevLens",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
